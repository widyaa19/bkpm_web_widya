    {
      "name": "POST - Registrasi user berhasil",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const unique = Date.now().toString();",
              "pm.variables.set('registerUsername', 'user_' + unique);",
              "pm.variables.set('registerEmail', 'user_' + unique + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
              "pm.test('Registrasi berhasil', function () { pm.expect(pm.response.json().success).to.eql(true); });"
            ]
